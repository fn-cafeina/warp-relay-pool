# Install (Docker Linux host):
#   1. Copy this file to /etc/systemd/system/warp-keep-cold.service
#      (and warp-keep-cold.timer alongside it).
#   2. Edit the User=/Group=/WorkingDirectory=/Environment=/ExecStart=
#      paths below. Defaults assume the repo lives at
#      /opt/warp-relay-pool — adjust if you cloned it elsewhere.
#   3. systemctl daemon-reload && systemctl enable --now warp-keep-cold.timer
# Template note: for a user instance (systemd --user) or an instantiated
# unit (warp-keep-cold@.service), replace User=/Group= with User=%i.
[Unit]
Description=Keep the WARP relay pool free of rate-limited egress IPs
Documentation=file:/opt/warp-relay-pool/keep-cold.mjs
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Edit to the user that owns the checkout (required for system units).
User=warp-relay
Group=warp-relay
# keep-cold shells out to `docker restart` for every rotation; a hand-install
# user that is not in the docker group would fail every tier-1 silently.
SupplementaryGroups=docker
WorkingDirectory=/opt/warp-relay-pool
# A full sweep probes every relay, then rotates each throttled one until it
# streams again (no time cap, MAX_RESET_ATTEMPTS per relay). Worst case on a
# 20-relay pool with two tier attempts each still fits inside this ceiling;
# flock turns an overlapping timer fire into a skip, not a second sweep.
TimeoutStartSec=3600
# The script rotates its own log, so no shell wrapper is needed here.
# Adjust the path below to where you cloned this repo.
Environment=KEEP_COLD_LOG=/opt/warp-relay-pool/keep-cold.log
# Pool size for the prober: must match the deployed relay count or the pass
# probes nonexistent relays. The wizard (setup.sh) rewrites this line to the
# actual count; edit it if you install the unit by hand.
Environment=COUNT=10
# Base port of the relay listeners (relay N listens on BASE_PORT+N). Must
# match the generated compose; the wizard rewrites it from .env/default.
Environment=BASE_PORT=3000
# -E 0: a skipped pass (timer fires while the previous one is still running)
# is contention, not failure; the pass result stays in the journal.
ExecStart=/usr/bin/flock -n -E 0 /tmp/warp-keep-cold.lock /usr/bin/node /opt/warp-relay-pool/keep-cold.mjs --sweep
StandardOutput=journal
StandardError=journal
