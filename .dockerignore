# The relay image needs only server.mjs and signal-writer.mjs; Bun and its
# standard library come from the pinned base image.
# Keep the whole checkout (including .env and WARP account material) out of
# the build context.
.git
.github
node_modules
logs
reference
devdocs
accounts
.env
.env.*
*.log
test
docs
systemd
warp-lite
# keep-cold runtime state (host-side scheduler + live-signal files): a bind
# mount at runtime, never build input.
.keep-cold
